`verilator_config

insert_dpihook -callback "cb_mem" -var "top_module.u.mem[1]"
insert_dpihook -callback "cb_sb" -var "top_module.u.s.b"
insert_dpihook -callback "cb_p" -var "top_module.u.p"
insert_dpihook -callback "cb_w" -var "top_module.u.w"
