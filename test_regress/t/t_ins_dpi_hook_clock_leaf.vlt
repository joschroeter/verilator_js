`verilator_config

insert_dpihook -callback "cb_bit" -var "top_module.clks[1]"
insert_dpihook -callback "cb_pb" -var "top_module.p.b"
insert_dpihook -callback "cb_x" -var "top_module.s2.in.x"
insert_dpihook -callback "cb_x" -var "top_module.s3.arr[1].x"
