`verilator_config

insert_dpihook -callback "cb_gen" -var "top_module.lane[0].cnt"
insert_dpihook -callback "cb_genexpr" -var "top_module.lanx[0].cnt"
insert_dpihook -callback "cb_nest" -var "top_module.outer[0].inner[1].cnt"
insert_dpihook -callback "cb_genassign" -var "top_module.lana[1].cnt"
