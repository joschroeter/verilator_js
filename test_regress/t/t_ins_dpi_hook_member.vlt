`verilator_config

insert_dpihook -callback "cb_member" -var "top_module.um.a"
insert_dpihook -callback "cb_a" -var "top_module.u2.a"
insert_dpihook -callback "cb_b" -var "top_module.u2.b"
insert_dpihook -callback "cb_struct" -var "top_module.us"
