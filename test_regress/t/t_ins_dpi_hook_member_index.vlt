`verilator_config

insert_dpihook -callback "cb_nib" -var "top_module.na[1].a"
insert_dpihook -callback "cb_byte" -var "top_module.s.arr[1]"
insert_dpihook -callback "cb_byte" -var "top_module.cs.d"
insert_dpihook -callback "cb_packedstruct" -var "top_module.pu.hi"
